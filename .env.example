# Copy to .env (git-ignored). SANDBOX credentials only — the client refuses non-sandbox hosts.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: id of a webhook registered in the PayPal developer dashboard; without it every webhook is UNVERIFIED.
PAYPAL_WEBHOOK_ID=
# LLM provider: anthropic (claude-opus-5-5, recommended) or gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Gemini alternative (Google AI Studio key; free tier ~20 requests/day/model)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Postgres (docker compose service `db` listens on 5433)
DATABASE_URL=postgresql+psycopg://payops:payops_local@localhost:5433/payops
PAYOPS_DB_PASSWORD=payops_local
# Server-side bearer token for every write endpoint. Unset => writes disabled. e.g. `openssl rand -hex 32`
OPERATOR_TOKEN=
# Policy
REFUND_CAP_MINOR=2500
APPROVAL_TTL_MINUTES=15
CORS_ORIGINS=http://localhost:3100
# Frontend (server-side only; never NEXT_PUBLIC_)
BACKEND_URL=http://127.0.0.1:8100
# Optional AG Studio license key (without it AG Studio runs in trial mode with a watermark)
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
# Console operators (HTTP Basic, checked by the Next.js proxy before it attaches OPERATOR_TOKEN). One credential per
# person: `node frontend/scripts/hash-operator.mjs alice 'pw'` -> paste entries comma-separated. Required anywhere
# non-local. With none set the console refuses everything unless LOCAL_CONSOLE=1 (dev only, bind to 127.0.0.1).
CONSOLE_OPERATORS=
# Signed operator identity for four-eyes (node frontend/scripts/gen-identity-keys.mjs). Private key: console server
# only. Public key: backend. Without them every backend caller is 'console', so approvals need LOCAL_CONSOLE=1 (dev).
OPERATOR_IDENTITY_PRIVATE_KEY=
OPERATOR_IDENTITY_PUBLIC_KEY=
LOCAL_CONSOLE=
# Hosts (host:port) the console may be served from; guards Origin/Host checks (CSRF, DNS rebinding).
CONSOLE_HOSTS=localhost:3100,127.0.0.1:3100
# Optional: sandbox PERSONAL (buyer) account for `make wallet` (PayPal-wallet-funded captures). Sandbox test account only.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
# Judge mode: replay the recorded Claude investigation (no LLM key needed); drafting then needs a live LLM
REPLAY_LLM=0
# AG Studio: trial licence key (optional; without it Studio runs in trial mode with a watermark) and AI assistant flag
AG_STUDIO_LICENSE_KEY=
STUDIO_AI=1
# Investigator tool-call budget per run
MAX_TOOL_CALLS=8
# Set to 0 to hide the AG Studio AI assistant at build time (STUDIO_AI=0 does the same at runtime)
NEXT_PUBLIC_STUDIO_AI=1
